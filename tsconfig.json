{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // `@/…` is the repository root; Biome forbids `../` imports (see biome.json).
    "paths": { "@/*": ["./*"] },

    // gql.tada types prefix.dev GraphQL documents from the introspected schema.
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "./tools/lib/capture/clients/prefix/schema.graphql",
        "tadaOutputLocation": "./tools/lib/capture/clients/prefix/graphql-env.d.ts"
      }
    ]
  },
  "exclude": ["node_modules", "vendor", "coverage"]
}
