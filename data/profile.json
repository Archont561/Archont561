      {
        "key": "test",
        "rule": "test behaviour, not lines",
        "detail": "Gherkin specs, property tests, a 90% floor"
      },
      {
        "key": "document",
        "rule": "docs ship with the code",
        "detail": "llms.txt and .md routes for agents"
      },
      {
        "key": "ship",
        "rule": "small commits, green gate first",
        "detail": "conventional commits, no force-push"
      },
      {
        "key": "enforce",
        "rule": "if a machine can check it, it does",
